# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Book PDFs — served via Supabase Storage signed URLs, never via /public/.
# Keep the manuscripts out of the repo so they cannot leak via GitHub.
public/Books/*.pdf
public/books/*.pdf
private/books/

# Per-run output from scripts/check-urls.mjs. Regenerable from the script.
scripts/check-urls-output*.json

# Google Cloud service-account keys. The real key lives outside the repo at
# %USERPROFILE%\.config\gcloud\noeldcosta-translate.json — these entries
# exist so a stray copy inside the repo never reaches GitHub.
noeldcosta-translate.json
*-service-account*.json
*-gcp-key*.json
.config/gcloud/
